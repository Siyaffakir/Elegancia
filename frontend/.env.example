# Base URL of the backend API
VITE_API_URL=http://localhost:5000/api

# Base URL for uploaded images (backend static root, no /api)
VITE_UPLOADS_URL=http://localhost:5000/uploads

# Secret admin URL path segment (hidden from all public UI buttons and links)
VITE_ADMIN_PATH=dz-admin-secure-portal-2026

# Shared API key sent as the X-API-Key header on every backend request.
# Must match API_KEY in backend/.env exactly.
VITE_API_KEY=replace_with_a_long_random_generated_key_min_16_chars
